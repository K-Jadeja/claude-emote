{
  "name": "claude-emote",
  "version": "0.1.0",
  "description": "Animated pixel-art avatar for Claude Code, ported from pi-emote.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "claude-emote": "bin/claude-emote.cjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "vitest run --no-file-parallelism --pool=forks",
    "test:unit": "vitest run tests/unit --no-file-parallelism --pool=forks",
    "test:integration": "vitest run tests/integration --no-file-parallelism --pool=forks",
    "test:focused": "vitest run --no-file-parallelism --pool=forks",
    "benchmark:latency": "node scripts/benchmark-latency.mjs",
    "demo": "node scripts/demo-states.mjs",
    "overlay:build": "node scripts/build-desktop-overlay.mjs",
    "overlay:typecheck": "tsc -p desktop/tsconfig.json",
    "overlay:setup": "node scripts/prepare-neutralino-runtime.mjs",
    "overlay:run": "npm run overlay:build && npm run overlay:setup && cd desktop && neu run",
    "overlay:package": "npm run overlay:build && npm run overlay:setup && cd desktop && neu build",
    "audit:runtime": "npm audit --omit=dev",
    "verify:upstream": "node scripts/verify-upstream.mjs",
    "validate:plugin": "claude plugin validate . --strict",
    "validate:package": "node scripts/validate-package.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.74.2",
    "@neutralinojs/lib": "6.9.0",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.0"
  },
  "devDependencies": {
    "@neutralinojs/neu": "11.7.1",
    "@types/node": "^20.14.10",
    "esbuild": "0.28.1",
    "typescript": "^5.5.4",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "bin",
    "bin/**",
    "hooks/hooks.json",
    ".claude-plugin/plugin.json",
    "emotes/ascii",
    "emotes/ascii/**",
    "emotes/default",
    "emotes/default/**",
    "config.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "package.json"
  ]
}
