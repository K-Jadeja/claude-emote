{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "dev.claudepet.overlay",
  "version": "0.1.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.exit",
    "debug.log",
    "window.beginDrag",
    "window.setAlwaysOnTop",
    "window.setBorderless",
    "window.setDraggableRegion",
    "window.getSize",
    "window.setSize"
  ],
  "modes": {
    "window": {
      "title": "Claude Pet",
      "width": 272,
      "height": 324,
      "minWidth": 272,
      "minHeight": 324,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": true,
      "icon": "/resources/assets/default/idle/idle.png",
      "enableInspector": false,
      "borderless": true,
      "transparent": true,
      "maximize": false,
      "hidden": false,
      "resizable": false,
      "exitProcessOnClose": true,
      "useSavedState": true
    }
  },
  "cli": {
    "binaryName": "claude-pet",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}
